#N canvas 60 40 720 520 12;
#X text 25 18 TEST TRANSPORT - defaults OFF. Click PLAY/STOP or bang test_play/test_stop.;
#X obj 35 55 bng 24 250 50 0 empty empty PLAY 30 12 0 10 #c7ff45 #000000 #000000;
#X obj 170 55 bng 24 250 50 0 empty empty STOP 30 12 0 10 #ff6e94 #000000 #000000;
#X obj 35 100 r test_play;
#X obj 170 100 r test_stop;
#X obj 35 135 t b b;
#X obj 170 135 t b b;
#X msg 35 170 1;
#X msg 170 170 0;
#X obj 35 205 s test_running;
#X obj 300 205 metro 125;
#X obj 430 55 r tempo;
#X obj 430 85 expr 15000 / max($f1 \, 1);
#X obj 300 245 f 0;
#X obj 355 245 + 1;
#X obj 355 275 mod 256;
#X obj 300 305 + 1;
#X obj 300 335 s music_step;
#X obj 430 305 expr int(($f1 - 1) / 16) % 13;
#X obj 430 335 s platform_id;
#X msg 110 170 0;
#X obj 570 55 loadbang;
